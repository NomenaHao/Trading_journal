# Trading Journal — Backend
# Copiez ce fichier en .env et adaptez les valeurs.

# Port de l'API
PORT=3001

# Environnement Node (development | production)
NODE_ENV=development

# Clé secrète JWT — changez-la en production (min. 32 caractères)
JWT_SECRET=changez-moi-en-production-utilisez-une-cle-longue-et-aleatoire
